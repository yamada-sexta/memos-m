<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="backup_description">계정, 설정, 오프라인 사본, 초안을 백업합니다. 복원된 캐시는 서버 데이터를 덮어쓰지 않습니다.</string>
    <string name="backup_export_description">.mmbackup 파일에 저장할 계정과 데이터 선택</string>
    <string name="backup_import_description">복원할 계정과 로컬 데이터 선택</string>
    <string name="backup_android_description">암호화된 백업을 사용할 수 있으면 Android가 계정 정보를 자동으로 백업합니다. 기기 간 직접 전송에는 설정, 캐시, 다운로드한 미디어, 초안도 포함됩니다.</string>
    <string name="backup_choose_export">백업할 데이터 선택</string>
    <string name="backup_choose_restore">복원할 데이터 선택</string>
    <string name="backup_accounts_heading">계정</string>
    <string name="backup_contents_heading">내용</string>
    <string name="backup_category_accounts">계정 정보 및 로그인 토큰</string>
    <string name="backup_category_settings">앱 설정</string>
    <string name="backup_category_cache">캐시된 메모 및 서버 데이터</string>
    <string name="backup_category_media">다운로드한 미디어</string>
    <string name="backup_category_drafts">초안 및 로컬 첨부 파일</string>
    <string name="backup_category_queued">대기 중인 수정 사항(선택 사항)</string>
    <string name="backup_password_protection">비밀번호로 보호</string>
    <string name="backup_credentials_description">계정 백업에는 로그인 토큰이 포함됩니다. 비밀번호 보호는 선택 사항입니다. 다른 사람이 접근할 수 없는 곳에 백업을 보관하세요.</string>
    <string name="backup_password">백업 비밀번호</string>
    <string name="backup_repeat_password">비밀번호 확인</string>
    <string name="backup_replace_title">선택한 로컬 데이터를 교체하시겠습니까?</string>
    <string name="backup_replace_description">선택한 계정과 항목만 교체됩니다. 다른 계정과 선택하지 않은 항목은 그대로 유지됩니다. 서버 데이터는 변경되지 않습니다.</string>
    <string name="backup_restore_summary">계정 %1$d개, 캐시된 메모 %2$d개, 초안 %3$d개, 미디어 파일 %4$d개를 복원했습니다. 선택한 대기 중인 수정 사항은 검토할 수 있도록 별도로 저장됩니다.</string>
    <string name="backup_legacy_explanation">이 이전 형식의 백업에서는 캐시만 복원할 수 있습니다. 대기 중인 작업과 서버 반영 전의 로컬 수정은 무시되므로 서버 데이터가 변경되지 않습니다.</string>
    <string name="backup_edit_review_title">복원된 대기 중인 수정 사항</string>
    <string name="backup_edit_review_description">복원된 대기 중인 수정 사항은 자동으로 동기화되지 않습니다. 메모 수정 내용을 초안으로 저장한 후 직접 검토하고 게시하세요. 삭제와 반응은 일반 메모 기능을 사용하세요.</string>
    <string name="backup_save_as_draft">초안으로 저장</string>
    <string name="backup_edit_saved_draft">게시되지 않은 초안으로 저장했습니다. 초안을 열어 확인하세요.</string>
    <string name="backup_restore_before_login">백업 복원</string>
    <string name="backup_recovery_retry">복원 다시 시도</string>
</resources>
